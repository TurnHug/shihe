{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@shihe/domain": ["../../packages/domain/src/index.ts"],
      "@shihe/sky-layout": ["../../packages/sky-layout/src/index.ts"],
      "@shihe/db": ["../../packages/db/src/index.ts"],
      "@shihe/db/server": ["../../packages/db/src/queries.ts"]
    },
    "types": ["node", "react", "react-dom"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
